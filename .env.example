# Civora - Environment Configuration Template
# Do not store secrets or real credentials here

# Backend API URL (dejar vacío para usar simulación local en pruebas)
VITE_API_URL=https://api.civora.example.com/dev

# AWS Region
AWS_REGION=us-east-1

# Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleclientid123456789
VITE_COGNITO_DOMAIN=auth.civora.example.com

# S3 Configuration
EVIDENCE_BUCKET_NAME=civora-evidence-dev

# DynamoDB
TABLE_NAME=CivoraIncidents-dev

# OpenStreetMap / Proveedor de Mapas (Opcional)
# 1. OpenStreetMap oficial estándar (no requiere API key):
VITE_OSM_TILE_URL=https://api.openstreetmap.org/

# Proveedores de Autenticación Social (OAuth / SDKs)
# Client ID de Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# App ID de Meta Developers (developers.facebook.com > Mis Apps > Configuración Básica)
VITE_FACEBOOK_APP_ID=tu_facebook_app_id



