# ============================================================
# Civora — Plantilla de Variables de Entorno
# Copia este archivo a .env y rellena con tus valores reales
# ============================================================

# ── AWS Backend ──────────────────────────────────────────────
# URL base del API Gateway (obtenida en Outputs de sam deploy)
# Deja vacío para usar modo demo local sin ninguna cuenta AWS
VITE_API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/dev
VITE_AWS_REGION=us-east-1

# ── Cognito (Outputs de sam deploy) ───────────────────────────
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Dominio Cognito Hosted UI (en Consola AWS: Cognito > User Pool > App Integration > Domain)
VITE_COGNITO_DOMAIN=civora-dev.auth.us-east-1.amazoncognito.com

# ── Recursos Backend (Solo para Lambda, NO para el frontend) ──
AWS_REGION=us-east-1
EVIDENCE_BUCKET_NAME=civora-evidence-dev
TABLE_NAME=CivoraIncidents-dev
STATE_MACHINE_ARN=arn:aws:states:us-east-1:XXXXXXXXXXXX:stateMachine:civora-dev

# ── Mapa ──────────────────────────────────────────────────────
# Tiles gratuitos de OpenStreetMap — no requiere API Key
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Autenticación Social ──────────────────────────────────────
# Client ID de Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# App ID de Meta Developers → Mis Apps → Configuración Básica
VITE_FACEBOOK_APP_ID=tu_facebook_app_id
